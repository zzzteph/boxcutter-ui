# Optional overrides. NOTHING here is required — the server runs with `docker run` and no env file at all
# (SQLite + a unique, auto-persisted JWT secret are created on first boot). Set any of these with `-e VAR=…`
# on `docker run`, or mount this file as .env. All values below are the built-in defaults unless noted.

# ---- server ----
# SECRET_KEY is auto-generated and stored in the data volume on first boot. Set it explicitly ONLY when you
# run multiple server replicas (so they share one signing key).
# SECRET_KEY=

DATABASE_URL=sqlite:///./data/boxcutter_ui.db
# Scale out with MariaDB/MySQL (driver bundled; recommended for large fleets):
#   DATABASE_URL=mysql+pymysql://boxcutter:boxcutter@db:3306/boxcutter?charset=utf8mb4
# or Postgres:  DATABASE_URL=postgresql+psycopg://boxcutter:boxcutter@db:5432/boxcutter
JWT_EXPIRE_MINUTES=720

# seed admin (created on first boot; forced to change password)
ADMIN_USER=root
ADMIN_PASSWORD=root

# ENROLL_TOKEN is empty by default — create one in the UI (Scanners page). Set here only to pre-seed a token.
# ENROLL_TOKEN=

# stock scanning image the runners execute
BOXCUTTER_IMAGE=ghcr.io/zzzteph/boxcutter:latest

# stale job requeue (seconds without a heartbeat before a claimed job is returned to the queue) + retry cap
JOB_VISIBILITY_TIMEOUT=180
JOB_MAX_ATTEMPTS=3

# optional notifications on scan-done / new-critical (all blank = disabled)
NOTIFY_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- agent / scanner (usually passed to the agent container via -e, not this file) ----
SERVER_URL=http://boxcutter-server:8000   # the server's reachable URL (or the public https:// URL)
# ENROLL_TOKEN=                            # from the server's Scanners page
# API_KEY=                                 # optional: a system-user key may enroll an agent instead of a token
CONCURRENCY=2
RUNNER_UI_PORT=7070

# ---- web (dev only; prod SPA is same-origin) ----
VITE_API_BASE=http://localhost:8000
